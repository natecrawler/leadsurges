---
interface Props {
  title: string;
  features: string[];
  href?: string;
  icon?: 'cube' | 'graph' | 'link' | 'pencil';
}

const { title, features, href = '/services', icon = 'cube' } = Astro.props;
---

<div class="group relative bg-[#0f0a18]/60 border border-white/10 rounded-2xl p-8 backdrop-blur-sm hover:border-purple-400/40 hover:bg-[#150d22]/80 transition-all">
  <div class="absolute -top-px left-12 right-12 h-px bg-gradient-to-r from-transparent via-purple-400/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>

  <div class="w-14 h-14 mb-6 flex items-center justify-center rounded-xl bg-purple-500/10 border border-purple-400/30 text-purple-300">
    {icon === 'cube' && (
      <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M21 7.5 12 2 3 7.5m18 0L12 13M21 7.5v9L12 22m-9-14.5L12 13m-9-5.5v9L12 22m0-9v9" stroke-linejoin="round" stroke-linecap="round"/>
      </svg>
    )}
    {icon === 'graph' && (
      <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M3 17L9 11L13 15L21 7M21 7H15M21 7V13" stroke-linejoin="round" stroke-linecap="round"/>
      </svg>
    )}
    {icon === 'link' && (
      <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5" stroke-linejoin="round" stroke-linecap="round"/>
      </svg>
    )}
    {icon === 'pencil' && (
      <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M12 20h9M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5z" stroke-linejoin="round" stroke-linecap="round"/>
      </svg>
    )}
  </div>

  <h3 class="text-xl font-display font-bold text-white mb-4">{title}</h3>
  <ul class="space-y-2 mb-6">
    {features.map((f) => (
      <li class="text-white/70 text-sm flex items-start gap-2">
        <svg class="w-4 h-4 mt-0.5 text-purple-400 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.3 7.3a1 1 0 0 1-1.4 0L3.3 9.3a1 1 0 1 1 1.4-1.4L8.7 12l6.6-6.6a1 1 0 0 1 1.4 0z"/></svg>
        {f}
      </li>
    ))}
  </ul>

  <a href={href} class="inline-flex items-center gap-1 text-purple-300 text-sm font-semibold hover:text-purple-200 transition-colors">
    Learn more
    <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>
</div>
