---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  type?: 'button' | 'submit';
  class?: string;
}

const { href, variant = 'primary', size = 'md', type = 'button', class: extraClass = '' } = Astro.props;

const base = 'inline-flex items-center justify-center font-semibold rounded-full transition-all';
const sizes = {
  md: 'px-6 py-3 text-sm',
  lg: 'px-8 py-4 text-base',
};
const variants = {
  primary: 'bg-gradient-brand text-white shadow-lg shadow-purple-500/20 hover:shadow-purple-500/40 hover:-translate-y-0.5',
  secondary: 'bg-white/5 border border-white/15 text-white hover:bg-white/10 hover:border-white/25',
  ghost: 'text-white/80 hover:text-white hover:bg-white/5',
};
const classes = `${base} ${sizes[size]} ${variants[variant]} ${extraClass}`;
---

{href ? (
  <a href={href} class={classes}><slot /></a>
) : (
  <button type={type} class={classes}><slot /></button>
)}
