---
import LeadForm from './LeadForm.astro';
---

<dialog
  id="consult-modal"
  class="consult-modal"
  aria-labelledby="consult-modal-title"
>
  <div class="modal-inner">
    <button type="button" data-close-modal class="modal-close" aria-label="Close">
      <svg class="w-5 h-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 5l10 10M15 5L5 15" stroke-linecap="round"/></svg>
    </button>

    <div data-modal-state="form">
      <p class="text-purple-300 text-xs font-semibold uppercase tracking-[0.2em] mb-2" data-tier-eyebrow>Free consultation</p>
      <h2 id="consult-modal-title" class="font-display font-extrabold text-2xl sm:text-3xl text-white leading-tight mb-2" data-modal-title>
        Let's talk about your growth.
      </h2>
      <p class="text-white/65 text-sm leading-relaxed mb-8" data-modal-sub>
        Tell us a bit about your business. We'll get back to you within one business day.
      </p>

      <LeadForm
        formName="consultation"
        submitLabel="Request consultation"
        successAction="/thank-you"
        compact={true}
      />
    </div>

    <div data-modal-state="success" hidden class="text-center py-6">
      <div class="w-16 h-16 mx-auto mb-6 flex items-center justify-center rounded-full bg-purple-500/15 border border-purple-400/30 text-purple-300">
        <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h2 class="font-display font-extrabold text-2xl sm:text-3xl text-white mb-3">Thanks — we got it.</h2>
      <p class="text-white/65 leading-relaxed max-w-md mx-auto mb-8">
        We'll review your details and reach out within one business day. If it's urgent, give us a call at <a href="tel:+17605239428" class="text-purple-300 hover:text-purple-200 font-medium">(760) 523-9428</a>.
      </p>
      <button type="button" data-close-modal class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-white/5 border border-white/15 text-white text-sm font-semibold hover:bg-white/10 transition-colors">
        Close
      </button>
    </div>
  </div>
</dialog>

<style>
  .consult-modal {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 640px;
    width: calc(100% - 2rem);
    color: white;
  }
  .consult-modal::backdrop {
    background: rgba(0, 0, 0, 0.78);
    backdrop-filter: blur(6px);
  }
  .consult-modal[open] {
    animation: modal-in 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .modal-inner {
    position: relative;
    padding: 2rem 1.75rem;
    border-radius: 1.5rem;
    background: linear-gradient(135deg, rgba(126, 34, 206, 0.18), rgba(217, 70, 239, 0.06));
    border: 1px solid rgba(192, 132, 252, 0.25);
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.6);
  }
  .modal-inner::before {
    content: '';
    position: absolute;
    inset: 1px;
    border-radius: calc(1.5rem - 1px);
    background: #0a0510;
    z-index: -1;
  }
  @media (min-width: 640px) {
    .modal-inner { padding: 2.5rem; }
  }
  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 200ms, border-color 200ms;
  }
  .modal-close:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
  }
  @keyframes modal-in {
    from { opacity: 0; transform: translateY(12px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  body.modal-open {
    overflow: hidden;
  }
</style>

<script>
  const modal = document.getElementById('consult-modal') as HTMLDialogElement | null;
  if (modal) {
    const titleEl = modal.querySelector<HTMLElement>('[data-modal-title]');
    const subEl = modal.querySelector<HTMLElement>('[data-modal-sub]');
    const eyebrowEl = modal.querySelector<HTMLElement>('[data-tier-eyebrow]');
    const serviceSelect = modal.querySelector<HTMLSelectElement>('[data-service-select]');
    const form = modal.querySelector<HTMLFormElement>('form[data-lead-form]');
    const submitBtn = modal.querySelector<HTMLButtonElement>('[data-submit-btn]');
    const submitLabel = modal.querySelector<HTMLElement>('[data-submit-label]');
    const formPanel = modal.querySelector<HTMLElement>('[data-modal-state="form"]');
    const successPanel = modal.querySelector<HTMLElement>('[data-modal-state="success"]');

    const defaultTitle = titleEl?.textContent ?? '';
    const defaultSub = subEl?.textContent ?? '';
    const defaultEyebrow = eyebrowEl?.textContent ?? '';

    let tierContextField = form?.querySelector<HTMLInputElement>('input[name="tier-context"]');

    const openModal = (opts: { service?: string; tier?: string; plan?: string; title?: string } = {}) => {
      if (!modal) return;

      // Reset panels
      formPanel?.removeAttribute('hidden');
      successPanel?.setAttribute('hidden', '');

      // Apply tier context
      if (opts.title) titleEl!.textContent = opts.title;
      else titleEl!.textContent = defaultTitle;

      if (opts.tier && opts.plan) {
        eyebrowEl!.textContent = `${opts.tier} • ${opts.plan}`;
        subEl!.textContent = `You're interested in the ${opts.tier} plan. Tell us a bit about your business and we'll be in touch within one business day.`;
      } else {
        eyebrowEl!.textContent = defaultEyebrow;
        subEl!.textContent = defaultSub;
      }

      // Pre-select service
      if (opts.service && serviceSelect) {
        const match = Array.from(serviceSelect.options).find((o) => o.value === opts.service);
        if (match) serviceSelect.value = match.value;
      }

      // Set or update hidden tier-context field
      if (opts.tier || opts.plan) {
        const value = [opts.service, opts.tier, opts.plan].filter(Boolean).join(' • ');
        if (!tierContextField && form) {
          tierContextField = document.createElement('input');
          tierContextField.type = 'hidden';
          tierContextField.name = 'tier-context';
          form.appendChild(tierContextField);
        }
        if (tierContextField) tierContextField.value = value;
      } else if (tierContextField) {
        tierContextField.value = '';
      }

      modal.showModal();
      document.body.classList.add('modal-open');
    };

    const closeModal = () => {
      modal.close();
      document.body.classList.remove('modal-open');
    };

    document.querySelectorAll<HTMLElement>('[data-open-modal]').forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        openModal({
          service: trigger.dataset.service,
          tier: trigger.dataset.tier,
          plan: trigger.dataset.plan,
          title: trigger.dataset.title,
        });
      });
    });

    modal.querySelectorAll<HTMLElement>('[data-close-modal]').forEach((b) => {
      b.addEventListener('click', closeModal);
    });

    // Close when clicking on the backdrop
    modal.addEventListener('click', (e) => {
      const rect = (modal.querySelector('.modal-inner') as HTMLElement).getBoundingClientRect();
      const inside =
        e.clientY >= rect.top &&
        e.clientY <= rect.bottom &&
        e.clientX >= rect.left &&
        e.clientX <= rect.right;
      if (!inside) closeModal();
    });

    modal.addEventListener('close', () => {
      document.body.classList.remove('modal-open');
    });

    // AJAX submit so we can show inline success without leaving the page
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form || !submitBtn || !submitLabel) return;

      submitBtn.disabled = true;
      const origLabel = submitLabel.textContent;
      submitLabel.textContent = 'Sending…';

      try {
        const formData = new FormData(form);
        const body = new URLSearchParams(formData as any).toString();
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        if (!res.ok) throw new Error(`Submission failed (${res.status})`);
        formPanel?.setAttribute('hidden', '');
        successPanel?.removeAttribute('hidden');
      } catch (err) {
        console.error(err);
        submitLabel.textContent = 'Try again';
        submitBtn.disabled = false;
        return;
      }
      submitBtn.disabled = false;
      submitLabel.textContent = origLabel;
    });
  }
</script>
