---
import { testimonials, realTestimonials, resultStats } from '../data/testimonials';
import { googleReviews } from '../data/reviews';

// Review structured data is emitted ONLY for genuine reviews (real: true),
// so placeholder content never becomes fake schema.
const reviewSchema = realTestimonials.map((t) => ({
  '@context': 'https://schema.org',
  '@type': 'Review',
  itemReviewed: { '@type': 'LocalBusiness', name: 'Lead Surges' },
  author: { '@type': 'Person', name: t.name },
  reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
  reviewBody: t.quote,
}));
---

<section class="relative">
  <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 lg:py-28 border-t border-white/5">
    <div class="max-w-2xl mb-14 reveal">
      <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-4">What clients say</p>
      <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white leading-tight">
        Rated <span class="text-gradient">{googleReviews.rating.toFixed(1)} stars</span> by {googleReviews.count} businesses.
      </h2>
      <a
        href={googleReviews.url}
        target="_blank"
        rel="noopener"
        class="mt-5 inline-flex items-center gap-2 text-sm text-white/65 hover:text-white transition-colors"
      >
        <span class="flex items-center gap-0.5 text-amber-400" aria-hidden="true">
          {[0, 1, 2, 3, 4].map(() => (
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 1l2.9 6 6.6 1-4.8 4.6 1.1 6.6L10 16l-5.9 3.2L5.2 12.6.4 8l6.6-1L10 1z"/></svg>
          ))}
        </span>
        Read all reviews on Google →
      </a>
    </div>

    <div class="grid sm:grid-cols-3 gap-6 mb-14">
      {resultStats.map((stat, i) => (
        <div class:list={['p-7 rounded-2xl bg-white/[0.02] border border-white/5 text-center reveal', `reveal-delay-${i + 1}`]}>
          <div class="text-4xl lg:text-5xl font-display font-extrabold text-gradient mb-2">{stat.value}</div>
          <p class="text-white/60 text-sm leading-snug">{stat.label}</p>
        </div>
      ))}
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {testimonials.map((t, i) => (
        <figure class:list={['relative flex flex-col p-7 rounded-2xl bg-[#0f0a18]/60 border border-white/10 reveal', `reveal-delay-${i + 1}`]}>
          <div class="flex items-center justify-between mb-5">
            <div class="flex items-center gap-0.5 text-amber-400" aria-hidden="true">
              {[0, 1, 2, 3, 4].map(() => (
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 1l2.9 6 6.6 1-4.8 4.6 1.1 6.6L10 16l-5.9 3.2L5.2 12.6.4 8l6.6-1L10 1z"/></svg>
              ))}
            </div>
            {t.result && (
              <span class="px-3 py-1 rounded-full bg-purple-500/10 border border-purple-400/30 text-purple-300 text-xs font-semibold">
                {t.result}
              </span>
            )}
          </div>
          <blockquote class="text-white/80 leading-relaxed flex-1">“{t.quote}”</blockquote>
          <figcaption class="mt-6 pt-5 border-t border-white/10">
            <p class="font-display font-semibold text-white text-sm">{t.name}</p>
            <p class="text-white/55 text-sm">{t.business}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>

  {reviewSchema.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</section>
