---
import type { Tier } from '../data/pricing';

interface Props {
  tiers: Tier[];
  service: 'SEO' | 'Paid Search' | 'Web Design';
}

const { tiers, service } = Astro.props;

const formatPlan = (tier: Tier) =>
  typeof tier.price === 'number'
    ? `$${tier.price.toLocaleString()}${tier.priceSuffix}`
    : tier.price.toString();

const baseBtn =
  'w-full inline-flex items-center justify-center font-semibold rounded-full transition-all px-6 py-3 text-sm';
const primaryBtn =
  'bg-gradient-brand text-white shadow-lg shadow-purple-500/20 hover:shadow-purple-500/40 hover:-translate-y-0.5';
const secondaryBtn =
  'bg-white/5 border border-white/15 text-white hover:bg-white/10 hover:border-white/25';
---

<div class="grid md:grid-cols-3 gap-6 max-w-6xl mx-auto">
  {tiers.map((tier, i) => (
    <div class:list={[
      'relative p-8 rounded-3xl border transition-all flex flex-col reveal',
      `reveal-delay-${i + 1}`,
      tier.featured
        ? 'bg-gradient-to-br from-purple-700/30 via-purple-600/15 to-fuchsia-600/20 border-purple-400/40 shadow-2xl shadow-purple-500/10 md:scale-105'
        : 'bg-[#0f0a18]/60 border-white/10',
    ]}>
      {tier.featured && (
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-gradient-brand text-white text-xs font-semibold uppercase tracking-wider">
          Most Popular
        </div>
      )}
      <h3 class="text-2xl font-display font-bold text-white mb-2">{tier.name}</h3>
      <p class="text-white/65 text-sm leading-relaxed mb-6 min-h-[3rem]">{tier.desc}</p>
      <div class="mb-2">
        {typeof tier.price === 'number' ? (
          <>
            <span class="text-5xl font-display font-extrabold text-white">${tier.price.toLocaleString()}</span>
            <span class="text-white/60 ml-2">{tier.priceSuffix}</span>
          </>
        ) : (
          <span class="text-4xl lg:text-5xl font-display font-extrabold text-white">{tier.price}</span>
        )}
      </div>
      <div class="text-sm text-purple-300 font-semibold mb-6">{tier.meta}</div>
      <ul class="space-y-3 mb-8 flex-1">
        {tier.features.map((f) => (
          <li class="text-white/75 text-sm flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-purple-400 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.3 7.3a1 1 0 0 1-1.4 0L3.3 9.3a1 1 0 1 1 1.4-1.4L8.7 12l6.6-6.6a1 1 0 0 1 1.4 0z"/></svg>
            {f}
          </li>
        ))}
      </ul>
      <a
        href="/contact"
        data-open-modal
        data-service={service}
        data-tier={tier.name}
        data-plan={formatPlan(tier)}
        data-title={`${typeof tier.price === 'number' ? 'Get started with' : 'Talk to us about'} ${tier.name}`}
        class:list={[baseBtn, tier.featured ? primaryBtn : secondaryBtn]}
      >
        {typeof tier.price === 'number' ? 'Get started' : 'Talk to us'}
      </a>
    </div>
  ))}
</div>
