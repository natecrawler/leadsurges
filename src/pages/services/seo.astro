---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import PricingTiers from '../../components/PricingTiers.astro';
import { seoTiers } from '../../data/pricing';

const pillars = [
  {
    title: 'Technical SEO',
    desc: 'Website infrastructure that search engines love. We audit, fix, and continuously refine.',
    points: ['Website Speed Optimization', 'Crawl & Visibility', 'Mobile Responsiveness', 'Core Web Vitals'],
    icon: 'cube',
  },
  {
    title: 'On-Page SEO',
    desc: 'Content and structure optimized for both readers and ranking algorithms.',
    points: ['Keyword Research', 'Meta Tags & Headers', 'Internal Linking', 'Content Strategy'],
    icon: 'pencil',
  },
  {
    title: 'Off-Page SEO',
    desc: 'Authority and visibility built through quality backlinks and brand outreach.',
    points: ['Backlink Acquisition', 'Domain Authority', 'Competitive Link Analysis', 'Brand Outreach'],
    icon: 'link',
  },
];

const process = [
  { n: '01', title: 'Initial consultation', body: 'We clarify your business objectives and what success looks like.' },
  { n: '02', title: 'Audit & research', body: 'Website audit, competitor analysis, and keyword research.' },
  { n: '03', title: 'Strategy & implementation', body: 'A tailored plan executed by SEO specialists, not generalists.' },
  { n: '04', title: 'Monitoring & reporting', body: 'Monthly performance reports with clear next steps.' },
];

const locations = [
  { slug: 'apple-valley', label: 'Apple Valley' },
  { slug: 'victorville', label: 'Victorville' },
  { slug: 'hesperia', label: 'Hesperia' },
  { slug: 'barstow', label: 'Barstow' },
  { slug: 'lucerne-valley', label: 'Lucerne Valley' },
  { slug: 'adelanto', label: 'Adelanto' },
];
---

<Layout
  title="SEO Services"
  description="Technical SEO, on-page optimization, and off-page link building — built to drive organic traffic and grow your business long-term."
>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute -top-40 -right-40 w-[700px] h-[700px] rounded-full bg-gradient-to-br from-purple-600/25 via-fuchsia-500/15 to-transparent blur-3xl"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-6 lg:px-10 pt-20 pb-16 lg:pt-32 lg:pb-24">
      <a href="/services" class="inline-flex items-center gap-1 text-purple-300 text-sm font-medium mb-6 hover:text-purple-200">
        <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 4L6 8l4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        All services
      </a>
      <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-5">SEO</p>
      <h1 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.05] max-w-4xl">
        Rank where your <span class="text-gradient">customers are searching.</span>
      </h1>
      <p class="mt-7 text-lg text-white/70 max-w-2xl leading-relaxed">
        SEO that compounds. Three core service areas executed by specialists — no generalist agency churn, every engagement gets a tailored strategy.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <Button href="/contact" size="lg">Get a free audit</Button>
        <Button href="/pricing" variant="secondary" size="lg">See pricing</Button>
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 border-t border-white/5">
      <div class="max-w-2xl mb-14 reveal">
        <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-4">Three pillars</p>
        <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white leading-tight">
          The full SEO playbook.
        </h2>
      </div>
      <div class="grid lg:grid-cols-3 gap-6">
        {pillars.map((s, i) => (
          <div class:list={['relative p-8 rounded-2xl bg-[#0f0a18]/60 border border-white/10 reveal', `reveal-delay-${i + 1}`]}>
            <div class="w-14 h-14 mb-6 flex items-center justify-center rounded-xl bg-purple-500/10 border border-purple-400/30 text-purple-300">
              {s.icon === 'cube' && <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 7.5 12 2 3 7.5m18 0L12 13M21 7.5v9L12 22m-9-14.5L12 13m-9-5.5v9L12 22m0-9v9" stroke-linejoin="round" stroke-linecap="round"/></svg>}
              {s.icon === 'pencil' && <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5z" stroke-linejoin="round" stroke-linecap="round"/></svg>}
              {s.icon === 'link' && <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5" stroke-linejoin="round" stroke-linecap="round"/></svg>}
            </div>
            <h3 class="text-2xl font-display font-bold text-white mb-3">{s.title}</h3>
            <p class="text-white/65 leading-relaxed mb-6">{s.desc}</p>
            <ul class="space-y-2">
              {s.points.map((p) => (
                <li class="text-white/75 text-sm flex items-start gap-2">
                  <svg class="w-4 h-4 mt-0.5 text-purple-400 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.3 7.3a1 1 0 0 1-1.4 0L3.3 9.3a1 1 0 1 1 1.4-1.4L8.7 12l6.6-6.6a1 1 0 0 1 1.4 0z"/></svg>
                  {p}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 border-t border-white/5">
      <div class="max-w-2xl mb-14 reveal">
        <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-4">Process</p>
        <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white leading-tight">
          A four-step path to better rankings.
        </h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {process.map((step, i) => (
          <div class:list={['p-6 rounded-2xl bg-white/[0.02] border border-white/5 reveal', `reveal-delay-${i + 1}`]}>
            <div class="text-4xl font-display font-extrabold text-gradient mb-4">{step.n}</div>
            <h3 class="text-lg font-display font-bold text-white mb-2">{step.title}</h3>
            <p class="text-white/65 text-sm leading-relaxed">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 border-t border-white/5">
      <div class="max-w-2xl mb-12 reveal">
        <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-4">Service Areas</p>
        <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white leading-tight">
          Local SEO across the High Desert.
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
        {locations.map((loc, i) => (
          <a
            href={`/services/${loc.slug}`}
            class:list={[
              'group flex items-center justify-between p-5 rounded-xl bg-[#0f0a18]/60 border border-white/10 hover:border-purple-400/40 transition-all reveal',
              `reveal-delay-${(i % 4) + 1}`,
            ]}
          >
            <span class="font-display font-semibold text-white">SEO in {loc.label}</span>
            <svg class="w-5 h-5 text-purple-300 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor"><path d="M7.05 4.55a1 1 0 0 1 1.4 0l4.5 4.5a1 1 0 0 1 0 1.4l-4.5 4.5a1 1 0 0 1-1.4-1.4L10.59 10 7.05 6.46a1 1 0 0 1 0-1.4z"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 border-t border-white/5">
      <div class="max-w-2xl mb-14 reveal">
        <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-4">Pricing</p>
        <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white leading-tight">
          Monthly retainers, <span class="text-gradient">no contracts.</span>
        </h2>
        <p class="mt-5 text-white/65 leading-relaxed">
          Tiered by the number of target keywords we actively optimize. <a href="/pricing#seo" class="text-purple-300 hover:text-purple-200 font-medium">See full pricing details</a>.
        </p>
      </div>
      <PricingTiers tiers={seoTiers} />
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20">
      <div class="relative overflow-hidden rounded-3xl p-[1px] bg-gradient-to-br from-purple-500/40 via-purple-500/10 to-fuchsia-500/30 reveal">
        <div class="relative rounded-[calc(1.5rem-1px)] bg-[#0a0510] p-10 lg:p-16 overflow-hidden">
          <div class="absolute inset-0 pointer-events-none opacity-70">
            <div class="absolute -top-32 -right-24 w-[420px] h-[420px] rounded-full bg-purple-600/20 blur-3xl"></div>
            <div class="absolute -bottom-32 -left-24 w-[360px] h-[360px] rounded-full bg-fuchsia-500/15 blur-3xl"></div>
          </div>
          <div class="relative max-w-2xl">
            <h2 class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl text-white leading-tight">
              Ready to watch your <span class="text-gradient">organic traffic climb?</span>
            </h2>
            <p class="mt-5 text-white/70 leading-relaxed text-lg">
              Free SEO audit, no commitment. We'll show you exactly what's holding your rankings back.
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
              <Button href="/contact" size="lg">Get my free audit</Button>
              <Button href="/pricing" variant="secondary" size="lg">See pricing</Button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
