---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import PricingTiers from '../../components/PricingTiers.astro';
import { webDesignTiers } from '../../data/pricing';

const pillars = [
  {
    title: 'Conversion-First Design',
    body: 'Every page is built around a clear action. We strip the noise so visitors know exactly what to do next.',
  },
  {
    title: 'Built for Speed',
    body: 'Lightweight code, optimized images, modern infrastructure. Fast sites convert better and rank better — period.',
  },
  {
    title: 'Mobile-First Layouts',
    body: 'Over 60% of traffic comes from mobile. Your site is designed for thumbs first, then scaled up for desktop.',
  },
  {
    title: 'SEO-Friendly Foundation',
    body: 'Proper heading structure, semantic HTML, schema markup, and clean URLs. Search engines love it out of the box.',
  },
  {
    title: 'Easy to Update',
    body: 'No locked-down platforms. You can request changes anytime — we ship updates the same week, not next quarter.',
  },
  {
    title: 'Designed Around Your Brand',
    body: 'No cookie-cutter templates. Your site looks like your business — not the agency that built it.',
  },
];

const process = [
  { n: '01', title: 'Discovery', body: 'Goals, audience, competitors, content inventory. We start by listening, not pitching.' },
  { n: '02', title: 'Design', body: 'Wireframes and visual design tied to conversion goals — not just aesthetics.' },
  { n: '03', title: 'Build', body: 'Clean, fast, modern code. Built to load in under a second and last for years.' },
  { n: '04', title: 'Launch & Iterate', body: 'We launch, monitor, and refine. The first version is never the final version.' },
];
---

<Layout
  title="Web Design Services"
  description="Marketing-focused websites that turn visitors into leads. Fast, mobile-first, SEO-friendly, and built around your conversion goals."
>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute -top-40 -right-40 w-[700px] h-[700px] rounded-full bg-gradient-to-br from-purple-600/25 via-fuchsia-500/15 to-transparent blur-3xl"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-6 lg:px-10 pt-20 pb-16 lg:pt-32 lg:pb-24">
      <a href="/services" class="inline-flex items-center gap-1 text-purple-300 text-sm font-medium mb-6 hover:text-purple-200">
        <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 4L6 8l4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        All services
      </a>
      <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-5">Web Design</p>
      <h1 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.05] max-w-4xl">
        Websites that turn visitors <span class="text-gradient">into leads.</span>
      </h1>
      <p class="mt-7 text-lg text-white/70 max-w-2xl leading-relaxed">
        Most agency websites look pretty and convert poorly. We design for the bottom line first — speed, clarity, and a clear path to action on every page.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <Button href="/contact" size="lg">Start a project</Button>
        <Button href="/pricing" variant="secondary" size="lg">See pricing</Button>
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 border-t border-white/5">
      <div class="max-w-2xl mb-14 reveal">
        <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-4">What you get</p>
        <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white leading-tight">
          Built to win in 2026, not 2016.
        </h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {pillars.map((p, i) => (
          <div class:list={['relative p-6 rounded-2xl bg-[#0f0a18]/60 border border-white/10 reveal', `reveal-delay-${(i % 4) + 1}`]}>
            <h3 class="text-lg font-display font-bold text-white mb-2">{p.title}</h3>
            <p class="text-white/65 text-sm leading-relaxed">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 border-t border-white/5">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="reveal">
          <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-4">Why us</p>
          <h2 class="font-display font-bold text-3xl lg:text-4xl text-white leading-tight mb-6">
            We build websites that <span class="text-gradient">earn their keep.</span>
          </h2>
          <p class="text-white/70 leading-relaxed mb-4">
            A website is the only employee you have working 24/7. If yours isn't generating leads, it's costing you money — even when it looks fine.
          </p>
          <p class="text-white/70 leading-relaxed">
            We design and build sites that turn organic traffic, paid traffic, and word-of-mouth into actual customers. Every page has a job to do.
          </p>
        </div>

        <div class="grid grid-cols-2 gap-4 reveal reveal-delay-2">
          {[
            { stat: '< 1s', label: 'avg. page load time on built sites' },
            { stat: '95+', label: 'Lighthouse performance scores' },
            { stat: '60%', label: 'avg. lift in form conversions' },
            { stat: '6 wks', label: 'typical project timeline' },
          ].map((s) => (
            <div class="p-6 rounded-2xl bg-[#0f0a18]/60 border border-white/10">
              <div class="text-3xl lg:text-4xl font-display font-extrabold text-gradient mb-2">{s.stat}</div>
              <p class="text-white/65 text-sm leading-snug">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 border-t border-white/5">
      <div class="max-w-2xl mb-14 reveal">
        <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-4">Process</p>
        <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white leading-tight">
          From kickoff to launch in 6 weeks.
        </h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {process.map((step, i) => (
          <div class:list={['relative p-6 rounded-2xl bg-white/[0.02] border border-white/5 reveal', `reveal-delay-${i + 1}`]}>
            <div class="text-4xl font-display font-extrabold text-gradient mb-4">{step.n}</div>
            <h3 class="text-lg font-display font-bold text-white mb-2">{step.title}</h3>
            <p class="text-white/65 text-sm leading-relaxed">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 border-t border-white/5">
      <div class="max-w-2xl mb-14 reveal">
        <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-4">Pricing</p>
        <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white leading-tight">
          Project-based pricing. <span class="text-gradient">No hidden fees.</span>
        </h2>
        <p class="mt-5 text-white/65 leading-relaxed">
          One-time project fee with milestone payments. <a href="/pricing#web-design" class="text-purple-300 hover:text-purple-200 font-medium">See full pricing details</a>.
        </p>
      </div>
      <PricingTiers tiers={webDesignTiers} />
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20">
      <div class="relative overflow-hidden rounded-3xl p-[1px] bg-gradient-to-br from-purple-500/40 via-purple-500/10 to-fuchsia-500/30 reveal">
        <div class="relative rounded-[calc(1.5rem-1px)] bg-[#0a0510] p-10 lg:p-16 overflow-hidden">
          <div class="absolute inset-0 pointer-events-none opacity-70">
            <div class="absolute -top-32 -right-24 w-[420px] h-[420px] rounded-full bg-purple-600/20 blur-3xl"></div>
            <div class="absolute -bottom-32 -left-24 w-[360px] h-[360px] rounded-full bg-fuchsia-500/15 blur-3xl"></div>
          </div>
          <div class="relative max-w-2xl">
            <h2 class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl text-white leading-tight">
              Ready for a site that <span class="text-gradient">actually converts?</span>
            </h2>
            <p class="mt-5 text-white/70 leading-relaxed text-lg">
              Tell us about your business and we'll come back with a project scope and timeline.
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
              <Button href="/contact" size="lg">Start a project</Button>
              <Button href="tel:+17605239428" variant="secondary" size="lg">(760) 523-9428</Button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
