---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import { locations, type Location } from '../../data/locations';

export function getStaticPaths() {
  return locations.map((loc) => ({ params: { location: loc.slug }, props: loc }));
}

const loc = Astro.props as Location;
const nearby = locations.filter((l) => l.slug !== loc.slug);
const canonical = new URL(`/services/${loc.slug}`, Astro.site).toString();

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: loc.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://leadsurges.com/' },
    { '@type': 'ListItem', position: 2, name: 'Service Areas', item: 'https://leadsurges.com/service-areas' },
    { '@type': 'ListItem', position: 3, name: `SEO in ${loc.label}`, item: canonical },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `SEO Services in ${loc.label}, CA`,
  provider: { '@type': 'LocalBusiness', name: 'Lead Surges', telephone: '+1-760-523-9428' },
  areaServed: { '@type': 'City', name: loc.label, containedInPlace: { '@type': 'State', name: 'California' } },
  serviceType: 'Search Engine Optimization',
  description: `Local SEO services for businesses in ${loc.label}, California — including Google Business Profile optimization, local citation building, and location-specific content.`,
};
---

<Layout
  title={`SEO Services in ${loc.label}, CA`}
  description={`Local SEO services for businesses in ${loc.label}, California. Get found in Google search and Maps where your customers are looking.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute -top-40 -right-40 w-[700px] h-[700px] rounded-full bg-gradient-to-br from-purple-600/25 via-fuchsia-500/15 to-transparent blur-3xl"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-6 lg:px-10 pt-20 pb-16 lg:pt-32 lg:pb-24">
      <nav aria-label="Breadcrumb" class="mb-6 text-sm">
        <ol class="flex items-center gap-2 text-white/50">
          <li><a href="/" class="hover:text-white">Home</a></li>
          <li aria-hidden="true">·</li>
          <li><a href="/service-areas" class="hover:text-white">Service Areas</a></li>
          <li aria-hidden="true">·</li>
          <li class="text-white/80">SEO in {loc.label}</li>
        </ol>
      </nav>

      <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-5">Local SEO</p>
      <h1 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.05] max-w-4xl">
        SEO Services in <span class="text-gradient">{loc.label}, CA</span>
      </h1>
      <p class="mt-7 text-lg text-white/70 max-w-3xl leading-relaxed">{loc.intro}</p>
      <div class="mt-10 flex flex-wrap gap-4">
        <Button href="/contact" size="lg">Get a free audit</Button>
        <Button href="/pricing#seo" variant="secondary" size="lg">See pricing</Button>
      </div>

      <div class="mt-14 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-white/55">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-purple-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" stroke-linejoin="round"/></svg>
          {loc.label}, California
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-purple-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" stroke-linejoin="round"/></svg>
          Population {loc.population}
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-purple-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2v20M2 12h20" stroke-linecap="round"/></svg>
          High Desert region
        </div>
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 border-t border-white/5">
      <div class="grid lg:grid-cols-2 gap-16 reveal">
        <div>
          <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-4">Local market</p>
          <h2 class="font-display font-bold text-3xl lg:text-4xl text-white mb-6 leading-tight">
            What SEO looks like in <span class="text-gradient">{loc.label}.</span>
          </h2>
          <p class="text-white/70 leading-relaxed">{loc.marketContext}</p>
        </div>

        <div class="space-y-4">
          {[
            { t: 'Google Business Profile optimization', b: 'Show up in the local pack and Google Maps with a fully optimized profile.' },
            { t: 'Local citation building', b: 'Consistent business listings across directories search engines trust.' },
            { t: 'Location-specific content', b: 'Pages that signal you serve real customers in real places.' },
            { t: 'Review strategy', b: 'A system to earn and respond to the reviews that build trust and rankings.' },
          ].map(({ t, b }) => (
            <div class="p-5 rounded-xl bg-[#0f0a18]/60 border border-white/10">
              <h3 class="font-display font-bold text-white mb-2">{t}</h3>
              <p class="text-white/65 text-sm leading-relaxed">{b}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 border-t border-white/5">
      <div class="max-w-2xl mb-10 reveal">
        <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-4">Where in {loc.label}</p>
        <h2 class="font-display font-bold text-3xl sm:text-4xl text-white leading-tight mb-5">
          Neighborhoods & areas we serve.
        </h2>
        <p class="text-white/65 leading-relaxed">
          We work with businesses throughout {loc.label} and the surrounding High Desert. A few of the areas our clients call home:
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        {loc.neighborhoods.map((n) => (
          <span class="px-4 py-2 rounded-full bg-[#0f0a18]/60 border border-white/10 text-white/80 text-sm font-medium">
            {n}
          </span>
        ))}
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 border-t border-white/5">
      <div class="max-w-2xl mb-8 reveal">
        <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-4">Industries</p>
        <h2 class="font-display font-bold text-3xl sm:text-4xl text-white leading-tight">
          Who we help in {loc.label}.
        </h2>
      </div>
      <div class="flex flex-wrap gap-3">
        {loc.industries.map((ind) => (
          <span class="px-4 py-2 rounded-full bg-white/5 border border-white/10 text-white/80 text-sm font-medium">{ind}</span>
        ))}
      </div>
      <p class="mt-8 text-white/60 text-sm">
        Industry not listed? <a href="/contact" class="text-purple-300 hover:text-purple-200 font-medium">Get in touch</a> — we work with most service-based businesses.
      </p>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-3xl px-6 lg:px-10 py-20 border-t border-white/5">
      <div class="text-center mb-12 reveal">
        <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-4">FAQ</p>
        <h2 class="font-display font-bold text-3xl sm:text-4xl text-white leading-tight">
          Common {loc.label} SEO questions.
        </h2>
      </div>
      <div class="space-y-3">
        {loc.faqs.map((f) => (
          <details class="group p-5 rounded-xl bg-[#0f0a18]/60 border border-white/10 open:border-purple-400/30">
            <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
              <span class="font-display font-semibold text-white">{f.q}</span>
              <svg class="w-5 h-5 text-purple-300 transition-transform group-open:rotate-180 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor"><path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4z"/></svg>
            </summary>
            <p class="mt-4 text-white/70 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 border-t border-white/5">
      <div class="max-w-2xl mb-10 reveal">
        <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-4">Other High Desert cities</p>
        <h2 class="font-display font-bold text-3xl sm:text-4xl text-white leading-tight">
          We serve businesses across the High Desert.
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
        {nearby.map((n) => (
          <a
            href={`/services/${n.slug}`}
            class="group flex items-center justify-between p-5 rounded-xl bg-[#0f0a18]/60 border border-white/10 hover:border-purple-400/40 hover:bg-[#150d22]/80 transition-all"
          >
            <span class="font-display font-semibold text-white">SEO in {n.label}</span>
            <svg class="w-5 h-5 text-purple-300 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor"><path d="M7.05 4.55a1 1 0 0 1 1.4 0l4.5 4.5a1 1 0 0 1 0 1.4l-4.5 4.5a1 1 0 0 1-1.4-1.4L10.59 10 7.05 6.46a1 1 0 0 1 0-1.4z"/></svg>
          </a>
        ))}
      </div>
      <p class="mt-8 text-sm text-white/55">
        Or <a href="/service-areas" class="text-purple-300 hover:text-purple-200 font-medium">view all service areas</a>.
      </p>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20">
      <div class="relative overflow-hidden rounded-3xl p-[1px] bg-gradient-to-br from-purple-500/40 via-purple-500/10 to-fuchsia-500/30">
        <div class="relative rounded-[calc(1.5rem-1px)] bg-[#0a0510] p-10 lg:p-16 overflow-hidden">
          <div class="absolute inset-0 pointer-events-none opacity-70">
            <div class="absolute -top-32 -right-24 w-[420px] h-[420px] rounded-full bg-purple-600/20 blur-3xl"></div>
            <div class="absolute -bottom-32 -left-24 w-[360px] h-[360px] rounded-full bg-fuchsia-500/15 blur-3xl"></div>
          </div>
          <div class="relative max-w-2xl">
            <h2 class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl text-white leading-tight">
              Ready to be found in <span class="text-gradient">{loc.label}?</span>
            </h2>
            <p class="mt-5 text-white/70 leading-relaxed text-lg">
              Free SEO audit, no commitment. We'll show you exactly what's working and what isn't.
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
              <Button href="/contact" size="lg">Get my free audit</Button>
              <Button href="tel:+17605239428" variant="secondary" size="lg">(760) 523-9428</Button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
