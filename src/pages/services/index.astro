---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';

const services = [
  {
    slug: 'paid-search',
    title: 'Paid Search',
    tagline: 'Google Ads, ROI-first.',
    desc: 'Profitable Google Ads campaigns built around conversions, not impressions. Daily optimization, transparent reporting.',
    points: ['Campaign Strategy', 'Keyword & Intent Research', 'Conversion Tracking', 'Daily Optimization'],
    icon: 'graph',
  },
  {
    slug: 'seo',
    title: 'SEO',
    tagline: 'Rank where it counts.',
    desc: 'Technical, on-page, and off-page SEO that compounds over time. Local SEO is our specialty.',
    points: ['Technical SEO', 'On-Page Optimization', 'Off-Page Link Building', 'Local SEO'],
    icon: 'cube',
  },
  {
    slug: 'web-design',
    title: 'Web Design',
    tagline: 'Built to convert.',
    desc: 'Marketing-focused websites that turn visitors into leads. Fast, mobile-first, SEO-friendly.',
    points: ['Conversion-First Design', 'Built for Speed', 'Mobile-First Layouts', 'SEO-Friendly Foundation'],
    icon: 'pencil',
  },
];

const process = [
  { n: '01', title: 'Initial consultation', body: 'We clarify your business objectives and what success looks like.' },
  { n: '02', title: 'Audit & research', body: 'Audit, competitor analysis, and a baseline of where you stand today.' },
  { n: '03', title: 'Strategy & implementation', body: 'A tailored plan executed by specialists, not generalists.' },
  { n: '04', title: 'Monitoring & reporting', body: 'Monthly performance reports with clear next steps.' },
];

const locations = [
  { slug: 'apple-valley', label: 'Apple Valley' },
  { slug: 'victorville', label: 'Victorville' },
  { slug: 'hesperia', label: 'Hesperia' },
  { slug: 'barstow', label: 'Barstow' },
  { slug: 'lucerne-valley', label: 'Lucerne Valley' },
  { slug: 'adelanto', label: 'Adelanto' },
];
---

<Layout title="Services" description="Paid Search, SEO, and Web Design — three services built to grow real businesses. Executed by specialists, not generalists.">
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute -top-40 -right-40 w-[700px] h-[700px] rounded-full bg-gradient-to-br from-purple-600/25 via-fuchsia-500/15 to-transparent blur-3xl"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-6 lg:px-10 pt-20 pb-16 lg:pt-32 lg:pb-20">
      <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-5">Services</p>
      <h1 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.05] max-w-3xl">
        Three services. <span class="text-gradient">One outcome: growth.</span>
      </h1>
      <p class="mt-7 text-lg text-white/70 max-w-2xl leading-relaxed">
        We focus on the three channels that move the needle for real businesses. No bloated retainers, no service-list theater — just the work that drives leads.
      </p>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 pb-20">
      <div class="grid lg:grid-cols-3 gap-6">
        {services.map((s, i) => (
          <a
            href={`/services/${s.slug}`}
            class:list={[
              'group relative p-8 rounded-2xl bg-[#0f0a18]/60 border border-white/10 hover:border-purple-400/40 hover:bg-[#150d22]/80 transition-all flex flex-col reveal',
              `reveal-delay-${i + 1}`,
            ]}
          >
            <div class="w-14 h-14 mb-6 flex items-center justify-center rounded-xl bg-purple-500/10 border border-purple-400/30 text-purple-300">
              {s.icon === 'cube' && <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 7.5 12 2 3 7.5m18 0L12 13M21 7.5v9L12 22m-9-14.5L12 13m-9-5.5v9L12 22m0-9v9" stroke-linejoin="round" stroke-linecap="round"/></svg>}
              {s.icon === 'pencil' && <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5z" stroke-linejoin="round" stroke-linecap="round"/></svg>}
              {s.icon === 'graph' && <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 17L9 11L13 15L21 7M21 7H15M21 7V13" stroke-linejoin="round" stroke-linecap="round"/></svg>}
            </div>
            <p class="text-purple-300 text-sm font-semibold mb-2">{s.tagline}</p>
            <h2 class="text-2xl font-display font-bold text-white mb-3">{s.title}</h2>
            <p class="text-white/65 leading-relaxed mb-6">{s.desc}</p>
            <ul class="space-y-2 mb-8 flex-1">
              {s.points.map((p) => (
                <li class="text-white/75 text-sm flex items-start gap-2">
                  <svg class="w-4 h-4 mt-0.5 text-purple-400 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.3 7.3a1 1 0 0 1-1.4 0L3.3 9.3a1 1 0 1 1 1.4-1.4L8.7 12l6.6-6.6a1 1 0 0 1 1.4 0z"/></svg>
                  {p}
                </li>
              ))}
            </ul>
            <span class="inline-flex items-center gap-1 text-purple-300 text-sm font-semibold group-hover:text-purple-200 transition-colors">
              Learn more
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 border-t border-white/5">
      <div class="max-w-2xl mb-14 reveal">
        <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-4">Process</p>
        <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white leading-tight">
          A clear path, on every engagement.
        </h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {process.map((step, i) => (
          <div class:list={['p-6 rounded-2xl bg-white/[0.02] border border-white/5 reveal', `reveal-delay-${i + 1}`]}>
            <div class="text-4xl font-display font-extrabold text-gradient mb-4">{step.n}</div>
            <h3 class="text-lg font-display font-bold text-white mb-2">{step.title}</h3>
            <p class="text-white/65 text-sm leading-relaxed">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 border-t border-white/5">
      <div class="max-w-2xl mb-12 reveal">
        <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-4">Service Areas</p>
        <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white leading-tight">
          Local SEO across the High Desert.
        </h2>
        <p class="mt-5 text-white/70 leading-relaxed">
          Local SEO is our specialty. We serve businesses across the High Desert and Inland Empire.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
        {locations.map((loc, i) => (
          <a
            href={`/services/${loc.slug}`}
            class:list={[
              'group flex items-center justify-between p-5 rounded-xl bg-[#0f0a18]/60 border border-white/10 hover:border-purple-400/40 transition-all reveal',
              `reveal-delay-${(i % 4) + 1}`,
            ]}
          >
            <span class="font-display font-semibold text-white">Digital Marketing in {loc.label}</span>
            <svg class="w-5 h-5 text-purple-300 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor"><path d="M7.05 4.55a1 1 0 0 1 1.4 0l4.5 4.5a1 1 0 0 1 0 1.4l-4.5 4.5a1 1 0 0 1-1.4-1.4L10.59 10 7.05 6.46a1 1 0 0 1 0-1.4z"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20">
      <div class="text-center max-w-2xl mx-auto reveal">
        <h2 class="font-display font-bold text-3xl sm:text-4xl text-white mb-5">Ready to get started?</h2>
        <p class="text-white/70 mb-8 text-lg">View pricing or reach out for a free consultation.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <Button href="/pricing" size="lg">View Pricing</Button>
          <Button href="/contact" variant="secondary" size="lg">Contact Us</Button>
        </div>
      </div>
    </div>
  </section>
</Layout>
