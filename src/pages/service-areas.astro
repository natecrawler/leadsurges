---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { locations } from '../data/locations';

const hubFaqs = [
  {
    q: 'Do you only work with High Desert businesses?',
    a: "No — most of our clients are in the High Desert, but we work with businesses across the Inland Empire and remotely with clients elsewhere. The strategies don't change with geography; we just know the High Desert market especially well.",
  },
  {
    q: 'Can you help my business rank in multiple High Desert cities?',
    a: "Yes. Service-area businesses can rank across multiple cities with the right content architecture, Google Business Profile setup, and citation strategy. We handle multi-location and service-area campaigns regularly.",
  },
  {
    q: "What's the difference between local SEO and regular SEO?",
    a: "Local SEO focuses on visibility for searchers in a specific geographic area — Google Maps, the local pack (the 3-pack of map results), and 'near me' searches. Regular SEO focuses on national or topical visibility. Most High Desert businesses need both, weighted heavily toward local.",
  },
  {
    q: 'Do you provide service in cities outside this list?',
    a: "Yes, we take on clients from outside our listed service areas. Get in touch and we'll let you know if it's a fit.",
  },
  {
    q: "How is pricing different between cities?",
    a: "Pricing reflects competition, not geography. Lucerne Valley campaigns often fit our Bronze tier; Victorville campaigns may need Silver or Gold given the competitive landscape. See our pricing page for full details.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: hubFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://leadsurges.com/' },
    { '@type': 'ListItem', position: 2, name: 'Service Areas', item: 'https://leadsurges.com/service-areas' },
  ],
};
---

<Layout
  title="Service Areas"
  description="Local SEO, paid search, and web design serving Apple Valley, Victorville, Hesperia, Barstow, Lucerne Valley, and Adelanto."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute -top-40 -right-40 w-[700px] h-[700px] rounded-full bg-gradient-to-br from-purple-600/25 via-fuchsia-500/15 to-transparent blur-3xl"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-6 lg:px-10 pt-20 pb-12 lg:pt-32 lg:pb-16">
      <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-5">Service Areas</p>
      <h1 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.05] max-w-3xl">
        SEO across the <span class="text-gradient">High Desert.</span>
      </h1>
      <p class="mt-7 text-lg text-white/70 max-w-2xl leading-relaxed">
        Six cities, one focused team. We work primarily with businesses across the High Desert — close enough to know the local market, far enough to stay objective.
      </p>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 pb-8">
      <div class="rounded-3xl overflow-hidden border border-white/10 bg-[#0f0a18]/60 reveal">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d206604.3!2d-117.30!3d34.50!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1sen!2sus!4v1778747971201!5m2!1sen!2sus"
          class="block w-full h-[320px] md:h-[400px]"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Lead Surges service areas across the High Desert"
          aria-label="Map showing Lead Surges service areas across the High Desert"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-16">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {locations.map((loc, i) => (
          <a
            href={`/services/${loc.slug}`}
            class:list={[
              'group relative p-7 rounded-2xl bg-[#0f0a18]/60 border border-white/10 hover:border-purple-400/40 hover:bg-[#150d22]/80 transition-all flex flex-col reveal',
              `reveal-delay-${(i % 4) + 1}`,
            ]}
          >
            <div class="flex items-start justify-between gap-4 mb-4">
              <div>
                <h2 class="text-xl font-display font-bold text-white mb-1">{loc.label}</h2>
                <p class="text-purple-300 text-xs font-semibold uppercase tracking-wider">Population {loc.population}</p>
              </div>
              <svg class="w-5 h-5 text-purple-300 transition-transform group-hover:translate-x-1 shrink-0 mt-1" viewBox="0 0 20 20" fill="currentColor"><path d="M7.05 4.55a1 1 0 0 1 1.4 0l4.5 4.5a1 1 0 0 1 0 1.4l-4.5 4.5a1 1 0 0 1-1.4-1.4L10.59 10 7.05 6.46a1 1 0 0 1 0-1.4z"/></svg>
            </div>

            <p class="text-white/65 text-sm leading-relaxed mb-5 flex-1">{loc.intro}</p>

            <div class="text-xs text-white/45 mb-2 font-semibold uppercase tracking-wider">Top industries</div>
            <div class="flex flex-wrap gap-1.5">
              {loc.industries.slice(0, 4).map((ind) => (
                <span class="px-2.5 py-1 rounded-full bg-white/[0.04] border border-white/10 text-white/65 text-xs">
                  {ind}
                </span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 border-t border-white/5">
      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <div class="reveal">
          <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-4">Why local matters</p>
          <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white leading-tight">
            High Desert SEO isn't <span class="text-gradient">national SEO.</span>
          </h2>
        </div>
        <div class="space-y-5 text-white/70 leading-relaxed reveal reveal-delay-2">
          <p>
            Most national SEO agencies treat every market the same — same playbooks, same content templates, same blanket strategies. That doesn't work in the High Desert.
          </p>
          <p>
            What your customers in <strong class="text-white">Apple Valley</strong> search for differs from what <strong class="text-white">Victorville</strong> residents search for, which differs from what tourists hitting <strong class="text-white">Barstow</strong> on Route 66 are looking for. Local SEO isn't just adding a city name to a page — it's understanding market dynamics, competitive sets, and search behavior on the ground.
          </p>
          <p>
            We've built our playbook around the way the High Desert actually works. It's why our clients see results faster than they did with their last agency.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-3xl px-6 lg:px-10 py-20 border-t border-white/5">
      <div class="text-center mb-12 reveal">
        <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-4">FAQ</p>
        <h2 class="font-display font-bold text-3xl sm:text-4xl text-white leading-tight">
          Questions about working with us.
        </h2>
      </div>
      <div class="space-y-3">
        {hubFaqs.map((f) => (
          <details class="group p-5 rounded-xl bg-[#0f0a18]/60 border border-white/10 open:border-purple-400/30">
            <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
              <span class="font-display font-semibold text-white">{f.q}</span>
              <svg class="w-5 h-5 text-purple-300 transition-transform group-open:rotate-180 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor"><path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4z"/></svg>
            </summary>
            <p class="mt-4 text-white/70 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20">
      <div class="relative overflow-hidden rounded-3xl p-[1px] bg-gradient-to-br from-purple-500/40 via-purple-500/10 to-fuchsia-500/30 reveal">
        <div class="relative rounded-[calc(1.5rem-1px)] bg-[#0a0510] p-10 lg:p-16 overflow-hidden">
          <div class="absolute inset-0 pointer-events-none opacity-70">
            <div class="absolute -top-32 -right-24 w-[420px] h-[420px] rounded-full bg-purple-600/20 blur-3xl"></div>
            <div class="absolute -bottom-32 -left-24 w-[360px] h-[360px] rounded-full bg-fuchsia-500/15 blur-3xl"></div>
          </div>
          <div class="relative max-w-2xl">
            <h2 class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl text-white leading-tight">
              Not sure which city you're in? <span class="text-gradient">Doesn't matter.</span>
            </h2>
            <p class="mt-5 text-white/70 leading-relaxed text-lg">
              Tell us about your business and we'll come back with a tailored local SEO plan — whether you're in one of our service areas or somewhere nearby.
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
              <Button href="/contact" size="lg">Get a free audit</Button>
              <Button href="tel:+17605239428" variant="secondary" size="lg">(760) 523-9428</Button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
