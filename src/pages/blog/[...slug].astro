---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const readingMinutes = Math.max(1, Math.round(post.body!.split(/\s+/).length / 220));

const allPosts = (await getCollection('blog')).filter((p) => p.id !== post.id);
const related = allPosts.slice(0, 2);
---

<Layout title={post.data.title} description={post.data.description}>
  <article class="relative">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute -top-40 -right-40 w-[700px] h-[700px] rounded-full bg-gradient-to-br from-purple-600/20 via-fuchsia-500/10 to-transparent blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-3xl px-6 lg:px-10 pt-20 lg:pt-32">
      <a href="/blog" class="inline-flex items-center gap-1 text-purple-300 text-sm font-medium mb-8 hover:text-purple-200">
        <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 4L6 8l4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        All posts
      </a>

      {post.data.category && (
        <span class="inline-block mb-5 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-400/30 text-purple-300 text-xs font-semibold">
          {post.data.category}
        </span>
      )}

      <h1 class="font-display font-extrabold text-4xl sm:text-5xl text-white leading-[1.1] mb-6">
        {post.data.title}
      </h1>

      <div class="flex items-center gap-3 text-sm text-white/60 mb-12 pb-8 border-b border-white/10">
        <span>{post.data.author}</span>
        <span class="text-white/30">·</span>
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        <span class="text-white/30">·</span>
        <span>{readingMinutes} min read</span>
      </div>

      <div class="prose-blog text-white/80">
        <Content />
      </div>
    </div>

    {related.length > 0 && (
      <div class="mx-auto max-w-3xl px-6 lg:px-10 pt-16 pb-20">
        <h2 class="font-display font-bold text-2xl text-white mb-6">Keep reading</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {related.map((p) => (
            <a href={`/blog/${p.id}`} class="block p-5 rounded-xl bg-[#0f0a18]/60 border border-white/10 hover:border-purple-400/40 transition-all">
              <h3 class="font-display font-bold text-white mb-2 leading-snug">{p.data.title}</h3>
              <p class="text-white/60 text-sm">{p.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    )}

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": post.data.title,
      "description": post.data.description,
      "author": { "@type": "Person", "name": post.data.author },
      "datePublished": post.data.pubDate.toISOString(),
      "publisher": {
        "@type": "Organization",
        "name": "Lead Surges",
        "logo": { "@type": "ImageObject", "url": "https://leadsurges.com/logo.png" }
      },
      "mainEntityOfPage": new URL(Astro.url.pathname, Astro.site).toString()
    })} />
  </article>
</Layout>

<style is:global>
  .prose-blog h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75rem;
    color: #fff;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }
  .prose-blog h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    color: #fff;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose-blog p {
    line-height: 1.75;
    margin-bottom: 1.25rem;
    font-size: 1.0625rem;
  }
  .prose-blog ul, .prose-blog ol {
    margin: 1.25rem 0;
    padding-left: 1.5rem;
  }
  .prose-blog li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }
  .prose-blog ul li { list-style: disc; }
  .prose-blog ol li { list-style: decimal; }
  .prose-blog strong { color: #fff; font-weight: 600; }
  .prose-blog a {
    color: #c084fc;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(192, 132, 252, 0.4);
  }
  .prose-blog a:hover { color: #d8b4fe; }
  .prose-blog blockquote {
    border-left: 3px solid #c084fc;
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: rgba(255, 255, 255, 0.85);
    font-style: italic;
  }
  .prose-blog code {
    background: rgba(192, 132, 252, 0.15);
    color: #e9d5ff;
    padding: 0.15rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
  }
</style>
