---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Testimonials from '../components/Testimonials.astro';
import { googleReviews } from '../data/reviews';
import { testimonialsReady } from '../data/testimonials';

// Show placeholder testimonials in local dev only; hide on the live build
// until real content is in and `testimonialsReady` is flipped to true.
const showTestimonials = testimonialsReady || import.meta.env.DEV;

const services = [
  {
    title: 'Paid Search',
    href: '/services/paid-search',
    icon: 'graph' as const,
    features: ['Google Ads management', 'Conversion tracking', 'Daily optimization', 'ROAS-focused reporting'],
  },
  {
    title: 'SEO',
    href: '/services/seo',
    icon: 'cube' as const,
    features: ['Technical SEO', 'On-page optimization', 'Off-page link building', 'Local SEO'],
  },
  {
    title: 'Web Design',
    href: '/services/web-design',
    icon: 'pencil' as const,
    features: ['Conversion-focused design', 'Built for speed', 'Mobile-first layouts', 'SEO-friendly foundation'],
  },
];

const locations = [
  { slug: 'apple-valley', label: 'Apple Valley' },
  { slug: 'victorville', label: 'Victorville' },
  { slug: 'hesperia', label: 'Hesperia' },
  { slug: 'barstow', label: 'Barstow' },
  { slug: 'lucerne-valley', label: 'Lucerne Valley' },
  { slug: 'adelanto', label: 'Adelanto' },
];
---

<Layout
  title="Lead Surges - SEO | Digital Marketing"
  description="Quality SEO services to boost your business's online visibility and drive organic traffic. Discover tailored strategies and watch your leads surge!"
>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-20 -right-40 w-[600px] h-[600px] rounded-full bg-gradient-to-br from-purple-600/30 via-fuchsia-500/20 to-transparent blur-3xl"></div>
      <div class="absolute top-60 -left-20 w-[400px] h-[400px] rounded-full bg-purple-700/20 blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-6 lg:px-10 pt-20 pb-28 lg:pt-32 lg:pb-40">
      <div class="grid lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-medium text-white/70 mb-8">
            <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
            Accepting new clients for Q4 2026
          </div>
          <h1 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl xl:text-7xl leading-[1.05] tracking-tight text-white">
            Maximize Your Business.
            <span class="block mt-2 text-gradient">Partner with Us for Results.</span>
          </h1>
          <p class="mt-7 text-lg text-white/70 max-w-xl leading-relaxed">
            Quality SEO and digital marketing built to grow real businesses. Tailored strategies, transparent reporting, and proven techniques that move the needle.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-4">
            <Button href="/pricing" size="lg">View Pricing</Button>
            <Button href="/contact" variant="secondary" size="lg">Contact Us</Button>
          </div>

          <a
            href={googleReviews.url}
            target="_blank"
            rel="noopener"
            class="mt-8 inline-flex items-center gap-3 text-sm text-white/70 hover:text-white transition-colors group"
          >
            <span class="flex items-center gap-0.5 text-amber-400" aria-hidden="true">
              {[0, 1, 2, 3, 4].map(() => (
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 1l2.9 6 6.6 1-4.8 4.6 1.1 6.6L10 16l-5.9 3.2L5.2 12.6.4 8l6.6-1L10 1z"/></svg>
              ))}
            </span>
            <span>
              <strong class="text-white font-semibold">{googleReviews.rating.toFixed(1)}</strong>
              from {googleReviews.count} Google reviews
            </span>
          </a>

          <div class="mt-14 flex flex-wrap items-center gap-x-8 gap-y-4 text-sm text-white/50">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-purple-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10 1l2.9 6 6.6 1-4.8 4.6 1.1 6.6L10 16l-5.9 3.2L5.2 12.6.4 8l6.6-1L10 1z"/></svg>
              Transparent reporting
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-purple-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10 1l2.9 6 6.6 1-4.8 4.6 1.1 6.6L10 16l-5.9 3.2L5.2 12.6.4 8l6.6-1L10 1z"/></svg>
              Data-driven strategies
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-purple-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10 1l2.9 6 6.6 1-4.8 4.6 1.1 6.6L10 16l-5.9 3.2L5.2 12.6.4 8l6.6-1L10 1z"/></svg>
              High Desert local
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 relative">
          <div class="relative aspect-square max-w-md mx-auto">
            <div class="absolute inset-0 rounded-full bg-gradient-to-br from-purple-600 via-fuchsia-500 to-pink-500 blur-2xl opacity-50"></div>
            <div class="relative w-full h-full rounded-full bg-gradient-to-br from-purple-600 to-fuchsia-600 p-1">
              <div class="w-full h-full rounded-full bg-[#0a0510] flex items-center justify-center overflow-hidden">
                <div class="text-center px-8">
                  <div
                    class="text-6xl lg:text-7xl font-display font-extrabold text-gradient mb-2"
                    data-counter="312"
                    data-prefix="+"
                    data-suffix="%"
                    data-duration="1800"
                  >+312%</div>
                  <p class="text-white/60 text-sm">average organic traffic lift for clients in their first 6 months</p>
                </div>
              </div>
            </div>
            <div class="absolute -bottom-4 -right-4 px-4 py-3 rounded-2xl bg-[#0f0a18] border border-white/10 shadow-xl">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-amber-400" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1l2.9 6 6.6 1-4.8 4.6 1.1 6.6L10 16l-5.9 3.2L5.2 12.6.4 8l6.6-1L10 1z"/></svg>
                <span class="text-xs text-white/70 font-medium">{googleReviews.rating.toFixed(1)} from {googleReviews.count} Google reviews</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-12 lg:py-16 border-t border-white/5">
      <p class="text-center text-purple-300/80 text-xs font-semibold uppercase tracking-[0.2em] mb-10 reveal">
        Trusted by brands across the High Desert
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 items-stretch">
        {[
          { src: '/logos/bear-valley-urgent-care.png', alt: 'Bear Valley Urgent Care' },
          { src: '/logos/choice-medical-group.png', alt: 'Choice Medical Group' },
          { src: '/logos/hyundai.svg', alt: 'Hyundai' },
          { src: '/logos/mazda.svg', alt: 'Mazda' },
          { src: '/logos/genesis.svg', alt: 'Genesis' },
          { src: '/logos/car-xchange.png', alt: 'CarXchange' },
        ].map((logo, i) => (
          <div
            class:list={['client-logo-card flex items-center justify-center rounded-xl bg-white/[0.03] border border-white/10 px-4 py-6 hover:bg-white/[0.06] hover:border-white/20 transition-all reveal', `reveal-delay-${(i % 4) + 1}`]}
            title={logo.alt}
          >
            <img
              src={logo.src}
              alt={logo.alt}
              loading="lazy"
              class="max-h-10 lg:max-h-12 w-auto max-w-full object-contain"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <style>
    .client-logo-card img {
      transition: opacity 200ms ease, filter 200ms ease;
    }
    .client-logo-card img[src$=".svg"] {
      filter: brightness(0) invert(1);
      opacity: 0.72;
    }
    .client-logo-card img[src$=".png"] {
      filter: grayscale(1) brightness(1.7) contrast(0.95);
      opacity: 0.78;
    }
    .client-logo-card:hover img {
      filter: none;
      opacity: 1;
    }
  </style>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 lg:py-28 border-t border-white/5">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="reveal">
          <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-4">About Us</p>
          <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white leading-tight">
            We help business owners <span class="text-gradient">surge ahead</span> of their competition.
          </h2>
          <p class="mt-6 text-white/70 leading-relaxed text-lg">
            We're a dedicated SEO company passionate about helping business owners like you enhance their online presence. Our team specializes in optimizing your website to improve search rankings, drive targeted traffic, and ultimately grow your business.
          </p>
          <p class="mt-4 text-white/70 leading-relaxed">
            With a focus on tailored strategies and proven techniques, we ensure your brand stands out in the competitive digital landscape.
          </p>
          <div class="mt-8">
            <Button href="/about" variant="secondary">More about us</Button>
          </div>
        </div>

        <div class="relative reveal reveal-delay-2">
          <div class="text-2xl lg:text-3xl font-display font-bold text-white leading-snug">
            You need innovative online marketing, and that's what we do. We are a team of
            <span class="text-gradient">digital marketers</span> who create meaningful, transformative experiences. We specialize in
            <span class="text-gradient">SEO, PPC</span> and
            <span class="text-gradient">Web Design</span>, designing and building digital experiences for the real world. Using
            <span class="text-gradient">data-driven</span> strategies to ensure your
            <span class="text-gradient">profits</span> along with monthly reports to show complete
            <span class="text-gradient">transparency</span>.
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 lg:py-28">
      <div class="max-w-2xl mb-14 reveal">
        <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-4">What We Do</p>
        <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white leading-tight">
          Services that turn search traffic into customers.
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((s, i) => (
          <div class:list={['reveal', `reveal-delay-${i + 1}`]}>
            <ServiceCard {...s} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 lg:py-28 border-t border-white/5">
      <div class="text-center max-w-2xl mx-auto mb-16 reveal">
        <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-4">Our Process</p>
        <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white leading-tight">
          A clear path from kickoff to results.
        </h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { n: '01', title: 'Consultation', body: 'We dig into your business goals, audience, and competitive landscape.' },
          { n: '02', title: 'Audit & Research', body: 'Technical audit, keyword research, and a baseline of where you stand today.' },
          { n: '03', title: 'Strategy & Build', body: 'On-page, off-page, and technical optimizations executed by SEO specialists.' },
          { n: '04', title: 'Monitor & Report', body: 'Monthly reports with the numbers that matter — and the next-step plan.' },
        ].map((step, i) => (
          <div class:list={['relative p-6 rounded-2xl bg-white/[0.02] border border-white/5 reveal', `reveal-delay-${i + 1}`]}>
            <div class="text-4xl font-display font-extrabold text-gradient mb-4">{step.n}</div>
            <h3 class="text-lg font-display font-bold text-white mb-2">{step.title}</h3>
            <p class="text-white/65 text-sm leading-relaxed">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 lg:py-28 border-t border-white/5">
      <div class="max-w-2xl mb-12 reveal">
        <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-4">Where We Work</p>
        <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white leading-tight">
          Digital marketing that knows your neighborhood.
        </h2>
        <p class="mt-5 text-white/70 leading-relaxed">
          Local SEO, paid search, and web design built around the High Desert markets we know best.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
        {locations.map((loc, i) => (
          <a
            href={`/service-areas/${loc.slug}`}
            class:list={[
              'group flex items-center justify-between p-5 rounded-xl bg-[#0f0a18]/60 border border-white/10 hover:border-purple-400/40 hover:bg-[#150d22]/80 transition-all reveal',
              `reveal-delay-${(i % 4) + 1}`,
            ]}
          >
            <span class="font-display font-semibold text-white">Digital Marketing in {loc.label}</span>
            <svg class="w-5 h-5 text-purple-300 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor"><path d="M7.05 4.55a1 1 0 0 1 1.4 0l4.5 4.5a1 1 0 0 1 0 1.4l-4.5 4.5a1 1 0 0 1-1.4-1.4L10.59 10 7.05 6.46a1 1 0 0 1 0-1.4z"/></svg>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="/service-areas" class="inline-flex items-center gap-1 text-purple-300 hover:text-purple-200 font-semibold text-sm">
          View all service areas
          <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>

  {showTestimonials && <Testimonials />}

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 lg:py-28">
      <div class="relative overflow-hidden rounded-3xl p-[1px] bg-gradient-to-br from-purple-500/40 via-purple-500/10 to-fuchsia-500/30 reveal">
        <div class="relative rounded-[calc(1.5rem-1px)] bg-[#0a0510] p-10 lg:p-16 overflow-hidden">
          <div class="absolute inset-0 pointer-events-none opacity-70">
            <div class="absolute -top-32 -right-24 w-[420px] h-[420px] rounded-full bg-purple-600/20 blur-3xl"></div>
            <div class="absolute -bottom-32 -left-24 w-[360px] h-[360px] rounded-full bg-fuchsia-500/15 blur-3xl"></div>
          </div>
          <div class="relative max-w-2xl">
            <h2 class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl text-white leading-tight">
              Ready to watch your <span class="text-gradient">leads surge?</span>
            </h2>
            <p class="mt-5 text-white/70 leading-relaxed text-lg">
              Book a free consultation and we'll walk through what a tailored SEO strategy looks like for your business.
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-gradient-brand text-white font-semibold text-base shadow-lg shadow-purple-500/20 hover:shadow-purple-500/40 hover:-translate-y-0.5 transition-all">
                Book a consultation
              </a>
              <a href="/pricing" class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-white/5 border border-white/15 text-white font-semibold text-base hover:bg-white/10 hover:border-white/25 transition-all">
                See pricing
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
