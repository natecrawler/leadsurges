---
import Layout from '../layouts/Layout.astro';
import PricingTiers from '../components/PricingTiers.astro';
import ConsultModal from '../components/ConsultModal.astro';
import { services } from '../data/pricing';

const faqs = [
  {
    q: 'How long does SEO take to work?',
    a: 'Most clients see initial movement in 3 months and meaningful traffic gains between months 4–6. SEO compounds — the longer you stick with it, the bigger the returns get.',
  },
  {
    q: 'Are there setup fees or long-term contracts?',
    a: 'No setup fees on Paid Search or SEO retainers, and both run month-to-month. Web Design is project-based with a deposit and milestone payments.',
  },
  {
    q: 'Does my Paid Search budget include ad spend?',
    a: 'No — management fees and ad spend are separate. You pay Google directly for ad spend, and we manage the campaigns. This keeps things transparent.',
  },
  {
    q: 'Do you offer custom packages?',
    a: "Yes. If your business needs something more specific — enterprise SEO, multi-location strategies, e-commerce — get in touch and we'll scope it.",
  },
  {
    q: 'Can I combine services?',
    a: "Absolutely. Most of our best clients run Paid Search + SEO together. We'll bundle pricing and align the strategies so they reinforce each other.",
  },
];
---

<Layout title="Pricing" description="Transparent pricing across Paid Search, SEO, and Web Design. No setup fees, no surprise invoices, no long-term contracts.">
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute -top-40 -right-40 w-[700px] h-[700px] rounded-full bg-gradient-to-br from-purple-600/25 via-fuchsia-500/15 to-transparent blur-3xl"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-6 lg:px-10 pt-20 pb-12 lg:pt-32 lg:pb-16 text-center">
      <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-5">Pricing</p>
      <h1 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.05] max-w-3xl mx-auto">
        Simple pricing. <span class="text-gradient">Predictable growth.</span>
      </h1>
      <p class="mt-7 text-lg text-white/70 max-w-2xl mx-auto leading-relaxed">
        Three services, three pricing models, all transparent. No setup fees, no surprise invoices.
      </p>

      <div class="mt-10 inline-flex flex-wrap justify-center gap-2 p-1.5 rounded-full bg-white/5 border border-white/10">
        {services.map((s) => (
          <a href={`#${s.id}`} class="px-5 py-2 rounded-full text-sm font-medium text-white/75 hover:text-white hover:bg-white/5 transition-colors">
            {s.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  {services.map((service) => (
    <section id={service.id} class="relative scroll-mt-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-10 py-16 lg:py-20 border-t border-white/5">
        <div class="text-center mb-12 reveal">
          <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-3">{service.sub}</p>
          <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white leading-tight">
            {service.label}
          </h2>
        </div>
        <PricingTiers tiers={service.tiers} service={service.label as 'SEO' | 'Paid Search' | 'Web Design'} />
      </div>
    </section>
  ))}

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-12 border-t border-white/5">
      <p class="text-center text-white/55 text-sm">
        Combining services? <a href="/contact" class="text-purple-300 hover:text-purple-200 font-medium">Get in touch</a> for bundled pricing — most clients pair Paid Search with SEO for compounding results.
      </p>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-3xl px-6 lg:px-10 py-20 border-t border-white/5">
      <h2 class="font-display font-bold text-3xl lg:text-4xl text-white mb-10 text-center">Questions, answered.</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="group p-5 rounded-xl bg-[#0f0a18]/60 border border-white/10 open:border-purple-400/30">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="font-display font-semibold text-white">{f.q}</span>
              <svg class="w-5 h-5 text-purple-300 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4z"/></svg>
            </summary>
            <p class="mt-4 text-white/70 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ConsultModal />
</Layout>
