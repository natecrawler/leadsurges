---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

const tiers = [
  {
    name: 'Bronze',
    price: 1500,
    desc: 'Solid foundation for businesses just getting serious about SEO.',
    keywords: 4,
    featured: false,
    features: [
      'On-page optimization',
      'Performance reporting',
      'Keyword research',
      'Link acquisition',
      'Content creation',
      'Monthly strategy call',
    ],
  },
  {
    name: 'Silver',
    price: 2000,
    desc: 'Our most popular tier — built to accelerate growth for established businesses.',
    keywords: 6,
    featured: true,
    features: [
      'Everything in Bronze',
      '6 target keywords',
      'Expanded content production',
      'Aggressive link building',
      'Competitor monitoring',
      'Priority response',
    ],
  },
  {
    name: 'Gold',
    price: 3000,
    desc: 'Maximum velocity for businesses serious about dominating their market.',
    keywords: 10,
    featured: false,
    features: [
      'Everything in Silver',
      '10 target keywords',
      'Full content strategy',
      'Premium link building',
      'Technical SEO deep-dives',
      'Dedicated strategist',
    ],
  },
];

const faqs = [
  {
    q: 'How long does SEO take to work?',
    a: "Most clients see initial movement in 3 months and meaningful traffic gains between months 4–6. SEO compounds — the longer you stick with it, the bigger the returns get.",
  },
  {
    q: 'Are there setup fees or long-term contracts?',
    a: "No setup fees. We work on month-to-month engagements because our results should keep you, not a contract.",
  },
  {
    q: "What's included in 'target keywords'?",
    a: "The keywords we actively optimize and track for ranking improvement. Each tier covers a different volume — we'll help you pick the right ones during onboarding.",
  },
  {
    q: 'Do you offer custom packages?',
    a: 'Yes. If your business needs something more specific — enterprise SEO, multi-location strategies, e-commerce — get in touch and we\'ll scope it.',
  },
];
---

<Layout title="Pricing" description="Transparent SEO pricing — Bronze, Silver, and Gold packages starting at $1,500/month. No setup fees, no long-term contracts.">
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute -top-40 -right-40 w-[700px] h-[700px] rounded-full bg-gradient-to-br from-purple-600/25 via-fuchsia-500/15 to-transparent blur-3xl"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-6 lg:px-10 pt-20 pb-16 lg:pt-32 lg:pb-20 text-center">
      <p class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-5">Pricing</p>
      <h1 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.05] max-w-3xl mx-auto">
        Simple pricing. <span class="text-gradient">Predictable growth.</span>
      </h1>
      <p class="mt-7 text-lg text-white/70 max-w-2xl mx-auto leading-relaxed">
        Three tiers, month-to-month. No setup fees, no surprise invoices. Just SEO work that compounds.
      </p>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 pb-16">
      <div class="grid md:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {tiers.map((tier) => (
          <div class:list={[
            'relative p-8 rounded-3xl border transition-all',
            tier.featured
              ? 'bg-gradient-to-br from-purple-700/40 via-purple-600/20 to-fuchsia-600/30 border-purple-400/50 shadow-2xl shadow-purple-500/20 md:scale-105'
              : 'bg-[#0f0a18]/60 border-white/10',
          ]}>
            {tier.featured && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-gradient-brand text-white text-xs font-semibold uppercase tracking-wider">
                Most Popular
              </div>
            )}
            <h2 class="text-2xl font-display font-bold text-white mb-2">{tier.name}</h2>
            <p class="text-white/65 text-sm leading-relaxed mb-6 min-h-[3rem]">{tier.desc}</p>
            <div class="mb-6">
              <span class="text-5xl font-display font-extrabold text-white">${tier.price.toLocaleString()}</span>
              <span class="text-white/60 ml-2">/month</span>
            </div>
            <div class="text-sm text-purple-300 font-semibold mb-6">{tier.keywords} target keywords</div>
            <ul class="space-y-3 mb-8">
              {tier.features.map((f) => (
                <li class="text-white/75 text-sm flex items-start gap-2">
                  <svg class="w-4 h-4 mt-0.5 text-purple-400 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.3 7.3a1 1 0 0 1-1.4 0L3.3 9.3a1 1 0 1 1 1.4-1.4L8.7 12l6.6-6.6a1 1 0 0 1 1.4 0z"/></svg>
                  {f}
                </li>
              ))}
            </ul>
            <Button href="/contact" variant={tier.featured ? 'primary' : 'secondary'} class="w-full">
              Get started
            </Button>
          </div>
        ))}
      </div>
      <p class="text-center text-white/50 text-sm mt-8">
        Need something custom? <a href="/contact" class="text-purple-300 hover:text-purple-200 font-medium">Talk to us.</a>
      </p>
    </div>
  </section>

  <section class="relative">
    <div class="mx-auto max-w-3xl px-6 lg:px-10 py-20 border-t border-white/5">
      <h2 class="font-display font-bold text-3xl lg:text-4xl text-white mb-10 text-center">Questions, answered.</h2>
      <div class="space-y-3">
        {faqs.map((f, i) => (
          <details class="group p-5 rounded-xl bg-[#0f0a18]/60 border border-white/10 open:border-purple-400/30">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="font-display font-semibold text-white">{f.q}</span>
              <svg class="w-5 h-5 text-purple-300 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4z"/></svg>
            </summary>
            <p class="mt-4 text-white/70 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
